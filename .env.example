# Delter AI — environment configuration
# Copy to `.env` and fill in. Never commit `.env`. Nothing here is exposed to the browser:
# every provider call happens in server-side route handlers.

# --- Database -------------------------------------------------------------
# PostgreSQL. Any managed or self-hosted server works; a free Neon or Supabase
# database is enough to run and deploy this app.
#
# Local options:
#   docker run --name delter-pg -e POSTGRES_PASSWORD=delter -e POSTGRES_DB=delter_ai \
#     -p 5432:5432 -d postgres:17
#   -> DATABASE_URL="postgresql://postgres:delter@127.0.0.1:5432/delter_ai"
#
# On a serverless host use the POOLED connection string (Neon: the "-pooler"
# host). Direct connections exhaust a database's connection limit under
# per-request scaling.
DATABASE_URL="postgresql://postgres:delter@127.0.0.1:5432/delter_ai"

# --- Session security -----------------------------------------------------
# Used to sign/verify the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# --- AI providers ---------------------------------------------------------
# Provide at least one. Providers without a key are shown as "not configured"
# in the UI instead of failing silently.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""

# Optional: attribution headers OpenRouter asks for (https://openrouter.ai/docs)
OPENROUTER_APP_NAME="Delter AI"
OPENROUTER_APP_URL=""

# --- Runtime limits -------------------------------------------------------
MAX_UPLOAD_MB="25"

# Default cap on AI output tokens per request. Providers that pre-authorise
# credit (OpenRouter holds max_tokens x price) refuse uncapped requests on a
# small balance, so this must stay set. Raise it for long code generation.
AI_MAX_OUTPUT_TOKENS=2048

# --- Upload storage -------------------------------------------------------
# Where uploaded file BYTES live. Metadata always stays in the database.
#   local -> disk under STORAGE_ROOT (needs a persistent volume)
#   s3    -> any S3-compatible object store: Cloudflare R2, Supabase Storage,
#            AWS S3, MinIO. Required on a serverless host.
# An unrecognised value throws instead of silently falling back to disk.
STORAGE_DRIVER="local"
STORAGE_ROOT=""

# Only used when STORAGE_DRIVER="s3".
# Cloudflare R2: endpoint https://<account-id>.r2.cloudflarestorage.com, region "auto".
# AWS S3:        leave S3_ENDPOINT empty and set a real region.
S3_ENDPOINT=""
S3_REGION="auto"
S3_BUCKET=""
S3_ACCESS_KEY_ID=""
S3_SECRET_ACCESS_KEY=""
# Optional key prefix, e.g. "prod" or "staging", so one bucket can hold both.
S3_PREFIX=""
# Path-style addressing is what R2, Supabase and MinIO expect.
S3_FORCE_PATH_STYLE="true"

# --- Password reset email -------------------------------------------------
# Base URL of the reset page, e.g. https://app.delter.ai/reset-password.
# Left unset, Delter AI reports honestly that no email delivery is configured
# instead of pretending to send a message.
RESET_EMAIL_URL=""
