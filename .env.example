# Delter AI — environment configuration
# Copy to `.env` and fill in. Never commit `.env`. Nothing here is exposed to the browser:
# every provider call happens in server-side route handlers.

# --- Database -------------------------------------------------------------
# SQLite keeps the whole product self-contained. Swap for a Postgres URL later
# (e.g. postgresql://user:pass@host:5432/delter) without touching app code.
DATABASE_URL="file:../data/db.sqlite"

# --- Session security -----------------------------------------------------
# Used to sign/verify the session cookie. Generate with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64url'))"
SESSION_SECRET=""

# --- AI providers ---------------------------------------------------------
# Provide at least one. Providers without a key are shown as "not configured"
# in the UI instead of failing silently.
OPENAI_API_KEY=""
ANTHROPIC_API_KEY=""
OPENROUTER_API_KEY=""

# Optional: attribution headers OpenRouter asks for (https://openrouter.ai/docs)
OPENROUTER_APP_NAME="Delter AI"
OPENROUTER_APP_URL=""

# --- Runtime limits -------------------------------------------------------
MAX_UPLOAD_MB="25"

# Default cap on AI output tokens per request. Providers that pre-authorise
# credit (OpenRouter holds max_tokens x price) refuse uncapped requests on a
# small balance, so this must stay set. Raise it for long code generation.
AI_MAX_OUTPUT_TOKENS=2048

# --- Password reset email -------------------------------------------------
# Base URL of the reset page, e.g. https://app.delter.ai/reset-password.
# Left unset, Delter AI reports honestly that no email delivery is configured
# instead of pretending to send a message.
RESET_EMAIL_URL=""
